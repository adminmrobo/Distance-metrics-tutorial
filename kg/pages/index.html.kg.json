  {
   "id": "lab:concept/distance-metric",
   "type": "Concept",
   "label": {
    "ko": "거리 척도",
    "en": "Distance metric"
   },
   "anchor": "#stage",
   "level": 1,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "domain": [
    "geom",
    "math",
    "ml"
   ],
   "match": [],
   "definition": {
    "ko": "두 점(사람·글·도시)이 얼마나 먼지 재는 자. 자를 바꾸면 같은 두 사람의 거리가 달라진다."
   },
   "family": "geom"
  },
  {
   "id": "lab:concept/euclidean-distance",
   "type": "Concept",
   "label": {
    "ko": "유클리드 거리",
    "en": "Euclidean distance"
   },
   "anchor": "#stage",
   "level": 1,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "domain": [
    "geom",
    "math",
    "ml"
   ],
   "match": [],
   "definition": {
    "ko": "곧게 잰 거리. 시아 (4, 0, 10)와 모아 (12, 5, 7)는 √98 = 9.899."
   },
   "family": "geom"
  },
  {
   "id": "lab:concept/manhattan-distance",
   "type": "Concept",
   "label": {
    "ko": "맨해튼 거리",
    "en": "Manhattan distance"
   },
